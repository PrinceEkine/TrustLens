# Copy to .env and fill in from Firebase console > Project settings > Your apps (Web).
# The app runs in clearly-labeled demo mode until these are set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check reCAPTCHA Enterprise site key (Security > App Check > Apps > your web app).
# Leave empty for local dev: the app uses the App Check debug provider instead.
# Register the debug token printed in DevTools console under App Check > Apps > Manage debug tokens.
VITE_APPCHECK_SITE_KEY=
# Optional: override the Remote Config default cloud model.
# VITE_CLOUD_MODEL=gemini-3.8-flash
